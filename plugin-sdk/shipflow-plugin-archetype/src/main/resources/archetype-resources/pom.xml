<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <version>${version}</version>
  <packaging>jar</packaging>
  <name>${artifactId}</name>
  <description>A ShipFlow plugin, generated by shipflow-plugin-archetype.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Bump to match the shipflow-plugin-api / host ShipFlow version you're targeting. -->
    <shipflow-plugin-api.version>1.0.0</shipflow-plugin-api.version>
    <spring.version>6.1.14</spring.version>
    <!-- Matches ShipFlow backend's pinned Lombok version — older releases don't support newer
         JDKs' internal javac APIs used by annotation processing. -->
    <lombok.version>1.18.46</lombok.version>
  </properties>

  <dependencies>
    <!-- ShipFlow Plugin API — the SPI interfaces (RiskCalculatorPlugin, ReportGeneratorPlugin,
         IntegrationProviderPlugin). "provided" scope: the host ShipFlow backend supplies this
         jar at runtime — do NOT bundle it into your plugin's own jar. -->
    <dependency>
      <groupId>com.github.farzadsedaghatbin.shipflow</groupId>
      <artifactId>shipflow-plugin-api</artifactId>
      <version>${shipflow-plugin-api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Spring annotations (@Component etc.) — also supplied by the host Spring Boot app. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>${spring.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
