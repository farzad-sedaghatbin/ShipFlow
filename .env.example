# Environment Variables Template
# Copy this file to .env and fill in your actual values
# .env is git-ignored and will not be committed

# IMPORTANT: Spring Boot Environment Variable Naming
# Spring Boot maps environment variables to properties using this convention:
# - Dots (.) become underscores (_)
# - Property names become uppercase
# Example: app.ai.provider becomes APP_AI_PROVIDER
# Example: app.ai.openai.api-key becomes APP_AI_OPENAI_API_KEY

# =========================
# CORS Configuration
# =========================
# Set your domain(s) here if deploying to a custom domain
# Comma-separated list. Wildcards supported (e.g. http://localhost:*)
# ⚠️  REQUIRED for any deployment on a real domain — not optional.
# If your public origin is missing here, EVERY browser POST is rejected with
# "403 Invalid CORS request", and the login form displays that as
# "Invalid username or password". curl does not reproduce it (no Origin header).
CORS_ALLOWED_ORIGINS=https://myapp.example.com,http://localhost:*,http://127.0.0.1:*

# =========================
# AI Provider Configuration
# =========================
# Choose one provider: ollama, runpod, or openai
# Only uncomment the section for the provider you want to use

# =========================
# Option 1: Ollama (Local AI) - RECOMMENDED FOR DEVELOPMENT
# =========================
APP_AI_PROVIDER=ollama
APP_AI_OLLAMA_BASE_URL=http://localhost:11434
APP_AI_OLLAMA_MODEL=mistral:instruct
APP_AI_OLLAMA_TIMEOUT=180

# =========================
# Option 2: RunPod (Cloud AI - GPU)
# =========================
# Uncomment these if you want to use RunPod instead
# APP_AI_PROVIDER=runpod
# APP_AI_RUNPOD_BASE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID
# APP_AI_RUNPOD_API_KEY=your_runpod_api_key_here
# APP_AI_RUNPOD_MODEL=mistral:instruct
# APP_AI_RUNPOD_TIMEOUT=180
# APP_AI_RUNPOD_POLL_INTERVAL=2

# =========================
# Option 3: OpenAI (ChatGPT)
# =========================
# Uncomment these if you want to use OpenAI ChatGPT
# APP_AI_PROVIDER=openai
# APP_AI_OPENAI_API_KEY=sk-your_openai_api_key_here
# APP_AI_OPENAI_MODEL=gpt-4-turbo-preview
# APP_AI_OPENAI_TIMEOUT=120
# # Optional: Customize base URL for OpenAI-compatible APIs
# # APP_AI_OPENAI_BASE_URL=https://api.openai.com/v1

# =========================
# WebAuthn / Passkey Sign-In
# =========================
# rp-id MUST be exactly the domain the frontend is served from (no scheme, no
# port), e.g. "shipflow.example.com". rp-origin MUST be the exact
# scheme+host+port, e.g. "https://shipflow.example.com". Left at the
# localhost-only defaults below, every passkey register/login attempt fails
# with a browser-level RP-ID/origin-mismatch error once deployed to a real
# domain — this is not optional for production.
# ⚠️  REQUIRED for passkeys on a real domain — not optional.
# RP ID must be the bare domain serving the frontend (no scheme, no port);
# RP origin must be that exact origin. Left at the localhost defaults, the
# browser refuses registration and you only see "Failed to add passkey".
WEBAUTHN_RP_ID=shipflow.example.com
WEBAUTHN_RP_NAME=ShipFlow
WEBAUTHN_RP_ORIGIN=https://shipflow.example.com
