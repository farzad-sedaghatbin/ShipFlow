# Environment Variables Template
# Copy this file to .env and fill in your actual values
# .env is git-ignored and will not be committed

# =========================
# RunPod AI Configuration
# =========================
RUNPOD_BASE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_MODEL=mistral:instruct
RUNPOD_TIMEOUT=180
RUNPOD_POLL_INTERVAL=2

# =========================
# Alternative: Ollama (Local AI)
# =========================
# Uncomment these if you want to use Ollama instead of RunPod
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral:instruct
# OLLAMA_TIMEOUT=180
