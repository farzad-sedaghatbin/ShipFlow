# Environment Variables Template
# Copy this file to .env and fill in your actual values
# .env is git-ignored and will not be committed

# =========================
# Ollama (Local AI) - RECOMMENDED FOR DEVELOPMENT
# =========================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:instruct
OLLAMA_TIMEOUT=180

# =========================
# Alternative: RunPod (Cloud AI)
# =========================
# Uncomment these if you want to use RunPod instead of Ollama
# AI_PROVIDER=runpod
# RUNPOD_BASE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID
# RUNPOD_API_KEY=your_runpod_api_key_here
# RUNPOD_MODEL=mistral:instruct
# RUNPOD_TIMEOUT=180
# RUNPOD_POLL_INTERVAL=2
